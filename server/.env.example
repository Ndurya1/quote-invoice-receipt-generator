# Load with: python -m uvicorn app.main:app --env-file .env --reload
APP_NAME=quote-invoice-receipt generator API
APP_ENV=development
APP_DEBUG=false
# Percent-encode reserved characters in usernames/passwords (e.g. @ becomes %40).
DATABASE_URL=postgresql://billing_user:change_me@localhost:5432/billing
TEST_DATABASE_URL=postgresql://billing_user:change_me@localhost:5432/billing_test
# Generate a private random signing key; never commit the real value.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
